---
import type { Locale, SettingsData } from "../../server/content/types";
import MediaPicker from "./MediaPicker.astro";
interface Props { data: SettingsData; locale: Locale }
const { data } = Astro.props;
---
<fieldset><legend>Cài đặt hiển thị</legend><label>Tên website<input required data-path="siteName" value={data.siteName} /></label><label>Tên công ty<input required data-path="companyName" value={data.companyName} /></label><label>Tagline<textarea required data-path="tagline">{data.tagline}</textarea></label><label>Alt ảnh chính<input data-path="primaryMediaAlt" value={data.primaryMediaAlt} /></label></fieldset><fieldset><legend>SEO</legend><label>SEO title<input required data-path="seo.title" value={data.seo.title} /></label><label>SEO description<textarea required data-path="seo.description">{data.seo.description}</textarea></label><MediaPicker label="Ảnh SEO" path="seo.image.mediaId" value={data.seo.image?.mediaId ?? ""} /><label>Alt ảnh SEO<input data-path="seo.image.alt" value={data.seo.image?.alt ?? ""} /></label></fieldset><p class="form-note">Tên miền tin cậy được cấu hình trong Cloudflare và không thể đổi tại đây.</p>
