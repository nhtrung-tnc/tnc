---
import { env } from "cloudflare:workers";
import AdminLayout from "../../layouts/AdminLayout.astro";
import { listUsers } from "../../server/auth/management";
const users = await listUsers(env.DB, Astro.locals.actor!);
---
<AdminLayout title="Người dùng"><section class="management-panel"><h2>Mời người dùng</h2><p class="form-note">Lời mời tại đây chỉ cấp vai trò trong CMS. Bạn vẫn phải thêm email vào chính sách Cloudflare Access trong <a href="https://one.dash.cloudflare.com/" target="_blank" rel="noreferrer">Zero Trust Dashboard</a>.</p><form data-invite-user class="management-form"><label>Email<input name="email" type="email" required /></label><label>Vai trò<select name="role"><option value="editor">Editor</option><option value="admin">Admin</option></select></label><button type="submit">Tạo lời mời</button><span data-user-status aria-live="polite"></span></form></section><section class="management-panel"><h2>Danh sách người dùng</h2><div class="user-list">{users.map((user) => <form data-user-row data-user-id={user.id}><div><strong>{user.email}</strong><small>{user.linked ? "Đã liên kết Access" : "Đang chờ đăng nhập lần đầu"}</small></div><label>Vai trò<select name="role"><option value="editor" selected={user.role === "editor"}>Editor</option><option value="admin" selected={user.role === "admin"}>Admin</option></select></label><label class="checkbox"><input name="active" type="checkbox" checked={user.active} /> Đang hoạt động</label><button type="submit">Lưu</button><span data-row-status aria-live="polite"></span></form>)}</div></section><script>import "../../client/admin/users";</script></AdminLayout>
